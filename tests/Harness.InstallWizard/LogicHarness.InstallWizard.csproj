<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LogicHarness</RootNamespace>
    <!--
      Same idea as the BI Deployment Wizard's LogicHarness: compile and run
      the wizard's engine code for real, against the real V6.0 release
      files, with no Windows, IIS or SQL Server needed. It links the actual
      source files from the wizard project (no copies, no drift) and leaves
      out everything that talks to Windows, IIS, SQL Server or WinForms.

      Unlike the BI harness it does reference Microsoft.Data.SqlClient, only
      to parse the connection strings the wizard writes and prove they
      round-trip (passwords with ; and quotes included).
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>

    <Compile Include="../../src/GraniteInstallWizard/Models/GraniteComponent.cs" Link="Models/GraniteComponent.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Models/InstallContext.cs" Link="Models/InstallContext.cs" />

    <Compile Include="../../src/GraniteInstallWizard/Core/GraniteSqlScriptParser.cs" Link="Core/GraniteSqlScriptParser.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/DateFormatConverter.cs" Link="Core/DateFormatConverter.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/ConnectionStringFormatter.cs" Link="Core/ConnectionStringFormatter.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/AppSettingsWriter.cs" Link="Core/AppSettingsWriter.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/WindowsFeatureList.cs" Link="Core/WindowsFeatureList.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/InstallProfile.cs" Link="Core/InstallProfile.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/ReleaseFolderCheck.cs" Link="Core/ReleaseFolderCheck.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/FileDeployer.cs" Link="Core/FileDeployer.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/SiteConflictCheck.cs" Link="Core/SiteConflictCheck.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/ReleaseSource.cs" Link="Core/ReleaseSource.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/ReleaseLayout.cs" Link="Core/ReleaseLayout.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/HotfixScripts.cs" Link="Core/HotfixScripts.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/CustodianToken.cs" Link="Core/CustodianToken.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/ReportServerSetting.cs" Link="Core/ReportServerSetting.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/PortPlanner.cs" Link="Core/PortPlanner.cs" />
    <!-- Linked for their pure Blockers/Warnings rules; nothing here opens a connection. -->
    <Compile Include="../../src/GraniteInstallWizard/Core/SqlServerInspector.cs" Link="Core/SqlServerInspector.cs" />
    <Compile Include="../../src/GraniteInstallWizard/Core/SqlConnectionFactory.cs" Link="Core/SqlConnectionFactory.cs" />
    <!-- Left out (need Windows, IIS, SQL Server or WinForms at run time):
         Core/ProcessRunner, SqlInstanceDiscovery, DatabaseInstaller, PrerequisiteService,
         CertificateService, IisService, VerificationService,
         LocalAddressDiscovery, InstallRunner; all of UI/; MainForm; Program. -->
  </ItemGroup>

</Project>
