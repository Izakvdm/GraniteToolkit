<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- This project has zero PackageReferences on purpose (see the .csproj
       comment); it exists to compile against local net8.0 reference
       assemblies only. Restore still contacts every configured source by
       default even with nothing to fetch, and nuget.org is unreachable from
       this sandbox, so clear the source list to make restore fully offline. -->
  <packageSources>
    <clear />
  </packageSources>
</configuration>
