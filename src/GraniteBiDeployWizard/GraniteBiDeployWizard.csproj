<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GraniteBiDeployWizard</RootNamespace>
    <AssemblyName>GraniteBiDeployWizard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon></ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- Product metadata -->
    <Product>GraniteWMS BI Deployment Wizard</Product>
    <Company>Cradle Technology Services</Company>
    <Version>1.6.0</Version>
    <Description>Centralized wizard for deploying and scheduling the GraniteWMS BI reporting database sync.</Description>

    <!-- Windows Task Scheduler task registration and running the generated
         .bat under another Windows account both normally require elevation,
         so the wizard requests it up front via app.manifest rather than
         failing partway through Panel 5. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <!-- "TaskScheduler" by David Hall (Microsoft.Win32.TaskScheduler namespace) -->
    <PackageReference Include="TaskScheduler" Version="2.12.1" />
    <!-- Local Windows account enumeration for Panel 5's account picker (Core/WindowsAccountDiscovery.cs) -->
    <PackageReference Include="System.DirectoryServices.AccountManagement" Version="8.0.0" />
  </ItemGroup>

</Project>
